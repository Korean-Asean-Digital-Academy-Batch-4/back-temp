{
  "name": "edutrack-backend",
  "version": "1.0.0",
  "description": "EduTrack backend (Express + PostgreSQL) - EDU-2026-001",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
